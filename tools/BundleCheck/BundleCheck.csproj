<Project Sdk="Microsoft.NET.Sdk">

  <!-- The real bundle validator as a command line: tools/publish.ps1 -Verify (and so CI and the release workflow) runs it on the zip + manifest
       it just wrote, or on the folder in -SkipZip mode. A tool of the build, never part of the shipped folder (publish.ps1 builds it into its own work folder). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>PcMieru.BundleCheck</RootNamespace>
    <AssemblyName>BundleCheck</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PcMieru.Update\PcMieru.Update.csproj" />
  </ItemGroup>

</Project>
