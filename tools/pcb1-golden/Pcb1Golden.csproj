<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The harness for the golden files of the configuration code PCB1. It is built against the OLD revision (parts-life 0.7.4, pl-cloud
    commit 25e4571), never against this repository: build-harness.ps1 puts this folder into a temporary `git archive` of that revision.
    The reference below is relative to that copy (tools/pcb1-golden -> src/PartsLife.Checks). It is not part of PcMieru.slnx.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>Pcb1Golden</AssemblyName>
    <RootNamespace>Pcb1Golden</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PartsLife.Checks\PartsLife.Checks.csproj" />
  </ItemGroup>

</Project>
