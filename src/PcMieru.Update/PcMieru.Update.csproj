<Project Sdk="Microsoft.NET.Sdk">

  <!-- The distribution contract of the auto update (docs/unify/DESIGN-B.md 3): the version type, the pcm-bundle/1 manifest, the name rules and the bundle validator
       (step 1), and the release feed with its schedule and state (step 2: Feed/UpdateHttp.cs is the only file that names System.Net.Http), and the swap transaction (step 4: Transaction/, the only code
       that replaces files; every change goes through Transaction/TxIo.cs, which is where the fault injection hooks are).
       No reference to Gui, Cli or Core, so tools/BundleCheck can load it on its own. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>PcMieru.Update</RootNamespace>
    <!-- Transaction/TxNative.cs: library-import P/Invoke (MoveFileEx, GetDiskFreeSpaceEx, GetFileInformationByHandle). The swapper (src/PcMieru.Swap) is NativeAOT. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- The gate file's fixed name and bytes (src/PcMieru.Wire/Gate): the bundle validator checks its hash, and the install id is taken from it. Wire has no reference to anything else. -->
    <ProjectReference Include="..\PcMieru.Wire\PcMieru.Wire.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PcMieru.Update.Tests" />
  </ItemGroup>

</Project>
