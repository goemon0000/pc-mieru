<Project Sdk="Microsoft.NET.Sdk">

  <!--
    PCMieru.Swap.exe (DESIGN-B 5 and 13 item 3): the program that replaces the files of an install and puts them back. asInvoker, NativeAOT, no network code.
    It is built from src/PcMieru.Update/Transaction/ (SwapCli.cs is its program, Program.cs here is only the entry); it references the Update project for that, so the Update project's own
    network code (Feed/UpdateHttp.cs, the only file that names System.Net.Http) is in the assembly it compiles, but NativeAOT compiles only what the program can reach, and the swap code reaches none of it.
    tools/publish.ps1 proves that on the built exe: its imports are a narrow list without ws2_32, winhttp or wininet, and no network type name is in its bytes (see Test-SwapExe).
    It runs in two roles decided by its own path: I\update\recover.exe does the work; I\PCMieru.Swap.exe only hands over to it (a running exe cannot be replaced, and the swap replaces this file).
    /DEPENDENTLOADFLAG:0x800 = LOAD_LIBRARY_SEARCH_SYSTEM32; tools/publish.ps1 checks the flag in the exe.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>PCMieru.Swap</AssemblyName>
    <ApplicationIcon>..\..\assets\PCMieru.ico</ApplicationIcon>
    <RootNamespace>PcMieru.Swap</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <OptimizationPreference>Size</OptimizationPreference>
    <StackTraceSupport>false</StackTraceSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <EventSourceSupport>false</EventSourceSupport>
    <MetricsSupport>false</MetricsSupport>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PcMieru.Update\PcMieru.Update.csproj" />
    <ProjectReference Include="..\PcMieru.Wire\PcMieru.Wire.csproj" />
  </ItemGroup>

  <ItemGroup>
    <LinkerArg Include="/DEPENDENTLOADFLAG:0x800" />
  </ItemGroup>

  <!--
    Libraries that load a DLL by name at run time look next to the exe first, and in NativeAOT that is a real load by absolute path that DEPENDENTLOADFLAG and SetDefaultDllDirectories do not stop.
    Program.cs (NativeSearch.Pin) pins the listed assemblies to System32. The check below stops the publish if another assembly brings in a lazy load that also searches next to the exe, and also if it
    cannot vouch for the build (no map file, no lazy module symbols at all, an unknown symbol shape). Same check and same origin as src/PcMieru.Helper/PcMieru.Helper.csproj
    (the owner's pl-sensors, MIT, same owner: src/PartsLife.Check/PartsLife.Check.csproj).
  -->
  <PropertyGroup>
    <IlcGenerateMapFile>true</IlcGenerateMapFile>
    <!-- Assemblies pinned in NativeSearch.Pin (dots become underscores; the map abbreviates System.Private.CoreLib to S_P_CoreLib) -->
    <PinnedNativeSearchAssemblies>S_P_CoreLib;System_Diagnostics_Process;System_Security_Cryptography;Microsoft_Win32_Registry</PinnedNativeSearchAssemblies>
  </PropertyGroup>

  <UsingTask TaskName="CheckLazyNativeModules" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <MapFile ParameterType="System.String" Required="true" />
      <Pinned ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var pinned = new HashSet<string>(Pinned.Split(new[] { ';' }, StringSplitOptions.RemoveEmptyEntries));
        if (!File.Exists(MapFile))
        {
            Log.LogError("The ILC map file was not produced: " + MapFile + ". The native search check cannot run, so the publish is stopped.");
            return false;
        }
        var text = File.ReadAllText(MapFile);
        var seen = new HashSet<string>();
        var matches = Regex.Matches(text, @"__nativemodule_(\w+?)__Module__(\w+?)_(\d+)""");
        var loose = new HashSet<string>();
        foreach (Match m in Regex.Matches(text, @"__nativemodule_[^""<>\s]*")) loose.Add(m.Value);
        var strict = new HashSet<string>();
        foreach (Match m in matches) strict.Add(m.Value.TrimEnd('"'));
        if (matches.Count == 0)
        {
            Log.LogError("No __nativemodule_ (lazy P/Invoke) symbols were found in " + MapFile + ". The map format may have changed; the native search check cannot vouch for this build, so the publish is stopped.");
            return false;
        }
        foreach (var name in loose)
            if (!strict.Contains(name))
                Log.LogError("Unrecognised native module symbol in the ILC map: " + name + ". Update the check in PcMieru.Swap.csproj.");
        foreach (Match m in matches)
        {
            int flags = int.Parse(m.Groups[3].Value);
            string asm = m.Groups[1].Value, dll = m.Groups[2].Value;
            bool searchesExeDir = (flags & 0x2) != 0 || (flags & 0x800) == 0;
            if (!seen.Add(asm + "/" + dll)) continue;
            Log.LogMessage(MessageImportance.High, "  lazy native module: " + asm + " -> " + dll + " (search 0x" + flags.ToString("X") + ")");
            if (searchesExeDir && !pinned.Contains(asm))
                Log.LogError(asm + " loads " + dll + " at run time and searches next to the exe. Pin it to System32 in NativeSearch.Pin (Program.cs) and add it to PinnedNativeSearchAssemblies.");
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="CheckSwapNativeSearch" AfterTargets="IlcCompile">
    <CheckLazyNativeModules MapFile="$([System.IO.Path]::Combine($(MSBuildProjectDirectory), $(NativeIntermediateOutputPath), $(TargetName).map.xml))"
                            Pinned="$(PinnedNativeSearchAssemblies)" />
  </Target>

  <!--
    The shipped exe has NO test entry. Program.cs reaches the test-only entry (tests/PcMieru.Swap.TestBuild/TestEntry.cs) only behind the compile symbol PCM_SWAP_TESTBUILD, and that symbol belongs to the test build's
    project alone. A build of THIS project with it defined (a stray DefineConstants, a command line switch) stops here, before the compiler runs; tools/publish.ps1 then also looks for the entry's option name and
    environment variable name in the published exe.
  -->
  <Target Name="NoTestEntryInTheProduct" BeforeTargets="CoreCompile" Condition="$(DefineConstants.Contains('PCM_SWAP_TESTBUILD'))">
    <Error Text="PCM_SWAP_TESTBUILD is defined in the product's PCMieru.Swap project. The test entry (--test-swap) is only in tests/PcMieru.Swap.TestBuild and must never be in the shipped exe." />
  </Target>

  <!-- Dev builds: the start gate file beside the exe (see build/GateNextToExe.targets). The swap does not read it (it works on the gate of the install it is in); the copy keeps the dev output like the others. -->
  <Import Project="..\..\build\GateNextToExe.targets" />

</Project>
