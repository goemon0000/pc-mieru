<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Wire types shared by PcMieru.Core and the NativeAOT Helper.
    Must stay AOT-safe: no reflection-based JSON, no dependency on Core.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PcMieru.Wire</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

</Project>
