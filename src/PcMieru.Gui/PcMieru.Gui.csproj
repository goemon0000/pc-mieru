<Project Sdk="Microsoft.NET.Sdk">

  <!-- PCMieru.exe: the window. Runs as the logged-in user; anything that needs admin rights goes through the Helper. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>PCMieru</AssemblyName>
    <RootNamespace>PcMieru.Gui</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\PCMieru.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- The manifest (also PerMonitorV2) is the source of truth so the setting applies before any window exists; WFO0003 only asks to move it. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
    <ForceDesignerDpiUnaware>true</ForceDesignerDpiUnaware>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="PcMieru.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PcMieru.Core\PcMieru.Core.csproj" />
    <!-- The checks page (system, load, storage, history) draws the runs of PcMieru.Checks; the checks themselves live there (docs/unify/DESIGN-A.md 7). -->
    <ProjectReference Include="..\PcMieru.Checks\PcMieru.Checks.csproj" />
    <!-- The release feed, the update mode and the first-run choice (docs/unify/DESIGN-B.md 3.1, 4). The one HTTP client of the app lives there, in Feed\UpdateHttp.cs. -->
    <ProjectReference Include="..\PcMieru.Update\PcMieru.Update.csproj" />
    <!-- Not linked: only built, so PCMieru.SensorHost.exe lands next to the app (the GPU live values are read by that process). -->
    <ProjectReference Include="..\PcMieru.SensorHost\PcMieru.SensorHost.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- The same .ico as the exe, for the window and taskbar (a Form shows the WinForms default icon otherwise). -->
    <EmbeddedResource Include="..\..\assets\PCMieru.ico" LogicalName="PCMieru.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PcMieru.Gui.Tests" />
  </ItemGroup>

  <Import Project="..\..\build\SensorHostNextToApp.targets" />

</Project>
