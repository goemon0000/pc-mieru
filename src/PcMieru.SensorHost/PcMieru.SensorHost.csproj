<Project Sdk="Microsoft.NET.Sdk">

  <!-- Isolates vendor GPU APIs (NVML/ADLX) that can hang. stdout = one SensorFrame JSON line per tick. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>PCMieru.SensorHost</AssemblyName>
    <RootNamespace>PcMieru.SensorHost</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PcMieru.Core\PcMieru.Core.csproj" />
  </ItemGroup>

</Project>
