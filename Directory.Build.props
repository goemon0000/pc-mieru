<Project>

  <!-- Shared build settings. Integration owner only (docs/ARCHITECTURE.md). -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>en;ja</SatelliteResourceLanguages>

    <!-- Local default only (kept at the current release); tools/publish.ps1 passes the real version as -p:Version=x.y.z, and so does CI. -->
    <Version Condition="'$(Version)' == ''">0.5.0</Version>
    <Company>web-autoai.com</Company>
    <Authors>web-autoai.com</Authors>
    <Product>PC Mieru</Product>
    <Copyright>Copyright (c) 2026 web-autoai.com</Copyright>
    <RepositoryUrl>https://github.com/goemon0000/pc-mieru</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <!--
      GHSA-p3jp-9v83-76w9: Brotli decoder out-of-bounds write in the 10.0.9 runtime/ILCompiler packages.
      PC Mieru never decompresses Brotli.
      PcMieru.Update reads ZIP archives (Deflate and Stored only, via System.IO.Compression). Its one HttpClient (src/PcMieru.Update/Feed/UpdateHttp.cs, step 2) keeps
      AutomaticDecompression at None, so it never asks for Brotli and never decodes it; a test (NoNetworkTests) reads that file and fails if Brotli, DecompressionMethods.All
      or a BrotliStream shows up in code anywhere under src/. This suppression stands on that. Do not enable any automatic decompression while it stands.
      Remove this line once the SDK pinned in global.json ships the fixed runtime.
    -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-p3jp-9v83-76w9" />
  </ItemGroup>

</Project>
