<Project>

  <!-- Shared build settings. Integration owner only (docs/ARCHITECTURE.md). -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>en;ja</SatelliteResourceLanguages>

    <!-- tools/publish.ps1 and CI pass -p:Version=x.y.z; this is only the local default. -->
    <Version Condition="'$(Version)' == ''">0.2.0</Version>
    <Company>web-autoai.com</Company>
    <Authors>web-autoai.com</Authors>
    <Product>PC Mieru</Product>
    <Copyright>Copyright (c) 2026 web-autoai.com</Copyright>
    <RepositoryUrl>https://github.com/goemon0000/pc-mieru</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <!--
      GHSA-p3jp-9v83-76w9: Brotli decoder out-of-bounds write in the 10.0.9 runtime/ILCompiler packages.
      PC Mieru never decompresses Brotli (no HttpClient, no BrotliStream, no archive reading). Remove this line
      once the SDK pinned in global.json ships the fixed runtime.
    -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-p3jp-9v83-76w9" />
  </ItemGroup>

</Project>
