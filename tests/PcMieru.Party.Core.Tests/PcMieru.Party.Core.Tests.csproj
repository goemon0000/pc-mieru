<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests of the rules layer (PcMieru.Party.Core). No Windows needed: dotnet test tests/PcMieru.Party.Core.Tests -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>PcMieru.Party.Core.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PcMieru.Party.Core\PcMieru.Party.Core.csproj" />
    <ProjectReference Include="..\..\src\PcMieru.Core\PcMieru.Core.csproj" />
  </ItemGroup>

  <!-- The exe has no test project: its WPF-free source files are compiled in here (command line, strings, the model of the first-start dialogs). -->
  <ItemGroup>
    <Compile Include="..\..\src\PcMieru.Party\PartyArgs.cs" Link="Linked\PartyArgs.cs" />
    <Compile Include="..\..\src\PcMieru.Party\PartyMeasure.cs" Link="Linked\PartyMeasure.cs" />
    <Compile Include="..\..\src\PcMieru.Party\I18n\Strings.cs" Link="Linked\Strings.cs" />
    <Compile Include="..\..\src\PcMieru.Party\I18n\ImportFieldNames.cs" Link="Linked\ImportFieldNames.cs" />
    <Compile Include="..\..\src\PcMieru.Party\ImportDialogModel.cs" Link="Linked\ImportDialogModel.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tests run against the real text: passing on made-up text would not say the shipped text passes. -->
    <None Include="..\..\assets\party\story.json" Link="assets\story.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\assets\party\adventure.json" Link="assets\adventure.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
