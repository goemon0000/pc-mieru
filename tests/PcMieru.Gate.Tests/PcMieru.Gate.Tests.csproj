<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The start gate (DESIGN-B 4, step 3), tested the way it is used: with the real file system (shared and exclusive opens, junctions, ACLs) and with REAL child processes of every
    shipped exe. The exes are only BUILT by the references below (ReferenceOutputAssembly=false, like pcmi does for the SensorHost); each test copies the exe's build folder into its own
    scratch folder next to a gate file the test wrote, so nothing here touches an install, %LOCALAPPDATA% or the developer's settings (the children get an APPDATA of their own too).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>PcMieru.Gate.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="PcMieru.TestSupport" />
    <Using Include="Xunit.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Shared/BoundedProcess.cs" Link="Shared/BoundedProcess.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PcMieru.Wire\PcMieru.Wire.csproj" />
    <ProjectReference Include="..\..\src\PcMieru.Gui\PcMieru.Gui.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\PcMieru.Cli\PcMieru.Cli.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\PcMieru.SensorHost\PcMieru.SensorHost.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\PcMieru.Helper\PcMieru.Helper.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\PcMieru.NetMeter\PcMieru.NetMeter.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\PcMieru.PartyStub\PcMieru.PartyStub.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
